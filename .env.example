# Public Firebase web configuration. These values are safe to bundle into the
# browser, but must match the Firebase project used by the Cloud Run service.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-only values. Do not put these in a VITE_ variable or the frontend.
# For Cloud Run, inject GEMINI_API_KEY from Secret Manager instead.
FIREBASE_PROJECT_ID=
GEMINI_MODEL=gemini-2.5-flash